# Pinned upstream AlmaLinux ISO used for CI ISO builds (shell-sourceable).
#
# Update both values together from the official CHECKSUM file:
#   https://repo.almalinux.org/almalinux/10/isos/x86_64/CHECKSUM
# Pin a versioned ISO (not -latest-): the -latest- name silently changes
# content on point releases, which would break checksum verification.
UPSTREAM_ISO_URL="https://repo.almalinux.org/almalinux/10/isos/x86_64/AlmaLinux-10.2-x86_64-minimal.iso"
UPSTREAM_ISO_SHA256="1b532f534231da0d1cd0ccae622bea6cd588d8a0d7b259f1f131501a6eed41a4"
