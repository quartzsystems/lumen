# Version pins for the Lumen ISO build (shell-sourceable). Companion to
# upstream.env — UPDATE THEM TOGETHER when moving to a new upstream ISO.
#
# KERNEL_NEVR must be exactly the kernel carried by the upstream ISO's
# on-media Minimal repo: it becomes the live environment kernel AND the
# installed target kernel, and kmod-zfs (kABI-tracking) is verified against
# it at build time. The build fails loudly — printing the kernel it actually
# found — if this pin drifts from the media.
KERNEL_NEVR="kernel-6.12.0-211.7.3.el10_2"

# OpenZFS EL10 kABI kmod repo, ZFS_SERIES version branch (the zfs-release
# 3.x [zfs-2.3-kmod] repo). The stable [zfs-kmod] repo (epel/10/kmod) still
# carries only the 2.2 series on EL10. Path uses the MAJOR version (10);
# kmods can lag AlmaLinux point-release kernels (openzfs/zfs#17966) — the
# kABI and offline-resolve gates catch that. Plain http is deliberate: the
# host does not serve https (the official zfs.repo also uses http);
# integrity comes from RPM signatures verified against the pinned key in
# iso/keys/RPM-GPG-KEY-openzfs-2022.
ZFS_REPO_URL="http://download.zfsonlinux.org/2.3/epel/10/kmod/x86_64/"

# Package-name series used to pick the ZFS packages mirrored onto the ISO.
ZFS_SERIES="2.3"

# ELRepo EL10, for the DRBD 9 kernel module and its userland
# (kmod-drbd9x, drbd9x-utils). kABI-tracking exactly like kmod-zfs — and
# with the same real EL10 breakage history against point-release kernels —
# so the build gate verifies it against KERNEL_NEVR the same way. Integrity
# comes from RPM signatures verified against the pinned key in
# iso/keys/RPM-GPG-KEY-v2-elrepo.org (ELRepo's 2025 RSA-4096 v2 key; the
# original 2009 DSA-1024 key has SHA-1 self-signatures EL10's rpm-sequoia
# policy refuses to import, and signs nothing in the el10 repo anyway).
# Kernel, kmod-zfs, and kmod-drbd9x move
# together as one pinned set: bump one, re-verify all three.
DRBD_REPO_URL="https://elrepo.org/linux/elrepo/el10/x86_64/"

# The AlmaLinux HighAvailability repo: corosync, pacemaker, pcs, and the
# fence agents — none of it on a minimal ISO, mirrored like AppStream's
# virtualization stack.
ALMA_HA_URL="https://repo.almalinux.org/almalinux/10/HighAvailability/x86_64/os/"

# The AlmaLinux repositories everything the media lacks is mirrored from:
# the ZFS userland's tail, and the whole virtualization stack (AppStream —
# none of it is on a minimal ISO). Named here rather than taken from the
# build container's own repo files so the ISO's contents follow the pins
# instead of the image the build happens to run in.
#
# Which packages get mirrored is NOT pinned, and deliberately so: it is the
# dependency closure of the target package set in build-live-iso.sh, solved
# by dnf against the media repo, which is a list nobody could keep correct
# by hand across a point release. These repos still carry the superseded
# z-stream builds, which is what lets that solve land on builds that match
# the frozen media rather than dragging an upgrade of half of BaseOS along.
ALMA_BASEOS_URL="https://repo.almalinux.org/almalinux/10/BaseOS/x86_64/os/"
ALMA_APPSTREAM_URL="https://repo.almalinux.org/almalinux/10/AppStream/x86_64/os/"
