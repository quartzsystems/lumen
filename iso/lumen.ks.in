# Lumen appliance kickstart — interactive graphical install on AlmaLinux 10
# (x86_64).
#
# This is a template: @LUMEN_VERSION@ and @LUMEN_BUILD_DATE@ are replaced by
# iso/build-iso.sh before the kickstart is embedded. The placeholders appear
# only inside %post, so ksvalidator can validate this file as-is
# (make ks-validate).
#
# The kickstart is deliberately PARTIAL: Anaconda boots the graphical
# installer and only asks for what is left incomplete here —
#   - root password             (rootpw omitted -> spoke is mandatory)
#   - installation destination  (no clearpart/autopart -> pick the boot drive)
#   - management network        (no --bootproto/--activate -> pick the NIC,
#                                DHCP or static)
#   - time zone / locale        (prefilled below, changeable in the UI)
# Everything else (package set, install source, security posture) is fixed;
# the corresponding spokes are preseeded or hidden by the Anaconda profile in
# branding/anaconda/lumen-profile.conf (delivered via images/product.img,
# selected with inst.profile=lumen on the kernel command line).

graphical
reboot

# Install from the boot media; "lumen" is the local RPM repo that
# iso/build-iso.sh adds to the ISO root (mounted at /run/install/repo).
cdrom
repo --name=lumen --baseurl=file:///run/install/repo/lumen

# Prefilled defaults — all remain changeable in the installer UI.
lang en_US.UTF-8
keyboard --vckeymap=us
timezone Etc/UTC --utc

# Hostname only: without --bootproto/--activate the Network & Host Name
# spoke stays open for the operator to choose the management NIC and
# DHCP vs. static addressing.
network --hostname=lumen

# No clearpart/autopart: the Installation Destination spoke requires the
# operator to pick the boot drive; automatic (LVM) partitioning is the
# preselected scheme once a disk is chosen.
bootloader --timeout=1

selinux --enforcing
firewall --enabled --service=ssh
services --enabled=chronyd,sshd,firewalld

%packages
@core
chrony
firewalld
openssh-server
lumen-release
# TODO(hypervisor): the KVM stack lands here in a later milestone, e.g.:
#   libvirt-daemon-kvm
#   qemu-kvm
#   libvirt-client
#   swtpm
#   edk2-ovmf
%end

%post --log=/root/lumen-ks-post.log
# Stamp the image build metadata into /etc/lumen-release (the file itself is
# installed by the lumen-release RPM; this appends the per-image build line).
echo "build @LUMEN_VERSION@ (@LUMEN_BUILD_DATE@)" >> /etc/lumen-release
%end
