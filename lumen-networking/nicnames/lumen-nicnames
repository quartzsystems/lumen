#!/usr/bin/env bash
# lumen-nicnames — deterministic NIC names (nic0..nicN) for Lumen.
#
# Enumerates physical ethernet interfaces, orders them by PCI address, and
# writes one systemd link file per NIC:
#
#   <root>/etc/systemd/network/70-lumen-nic<N>.link
#     [Match] PermanentMACAddress=<mac>  ->  [Link] Name=nic<N>
#
# The name the kernel gave the adapter (enp3s0, eno1, …) is recorded as
# AlternativeName=, so udev keeps it usable and the console can show it in
# the Alternative Name column — that string is what ties a row in the table
# to a label on the chassis. It is only written when the adapter is actually
# being renamed; a NIC already called nic<N> has no alternative name.
#
# The USB gadget a BMC presents to its host (rndis_host and friends) is not a
# front-panel adapter and is skipped; it keeps its kernel name.
#
# Existing MAC->nic<N> pins are preserved: NICs added later get the next
# free index, so adding/replacing hardware never renames survivors. The
# .link files take effect when udev (re)processes the devices — i.e. on the
# next boot for an installed system.
#
# Usage:
#   lumen-nicnames [--root DIR]   write link files under DIR (default /)
#   lumen-nicnames --apply        additionally rename the running kernel's
#                                 interfaces in place (live installer
#                                 environment; must run before
#                                 NetworkManager configures anything)
set -euo pipefail

usage() { echo "usage: lumen-nicnames [--root DIR] [--apply]" >&2; }
die()   { echo "lumen-nicnames: $*" >&2; exit 1; }

ROOT="/"
APPLY=0
while [ $# -gt 0 ]; do
    case "$1" in
        --root)  ROOT="${2:?--root needs a value}"; shift 2 ;;
        --apply) APPLY=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) usage; die "unknown argument: $1" ;;
    esac
done
[ -d "$ROOT" ] || die "no such root: $ROOT"
LINKDIR="${ROOT%/}/etc/systemd/network"

# Drivers whose interfaces are not real front-panel adapters. A BMC exposes
# its shared-with-host side as a USB gadget on rndis_host or cdc_ether: it
# looks like an ordinary ethernet NIC in sysfs, but it leads to the service
# processor, not to the network the appliance is being installed onto. Naming
# it nic<N> would burn an index the operator's real adapters expect and offer
# a dead end as a management interface.
EXCLUDED_DRIVERS="rndis_host cdc_ether cdc_ncm cdc_eem"

# excluded_driver DEV — true when DEV's kernel driver is one of the above.
excluded_driver() {
    local link drv
    link="/sys/class/net/$1/device/driver"
    [ -e "$link" ] || return 1
    drv="$(readlink -f "$link")" || return 1
    drv="${drv##*/}"
    case " $EXCLUDED_DRIVERS " in *" $drv "*) return 0 ;; esac
    return 1
}

# --- enumerate physical ethernet NICs, ordered by PCI address ---------------
# Sort key is the resolved sysfs device path: fixed-width lowercase-hex PCI
# addresses sort correctly lexically, and nested buses (virtio on PCI) keep
# their parent's position.
mapfile -t nics < <(
    for path in /sys/class/net/*; do
        dev="$(basename "$path")"
        [ -e "$path/device" ] || continue            # physical devices only
        [ "$(cat "$path/type")" = "1" ] || continue  # ethernet only
        excluded_driver "$dev" && continue           # BMC/IPMI USB gadgets
        mac="$(cat "$path/address")"
        if [ -z "$mac" ] || [ "$mac" = "00:00:00:00:00:00" ]; then continue; fi
        printf '%s %s %s\n' "$(readlink -f "$path/device")" "$mac" "$dev"
    done | LC_ALL=C sort
)
[ "${#nics[@]}" -gt 0 ] || die "no physical ethernet interfaces found"

# --- load existing MAC -> index pins ----------------------------------------
# The recorded alternative name comes back too: on a re-run the adapter is
# already called nic<N>, so the original name is only still knowable from the
# file that recorded it the first time.
#
# Keyed by MAC rather than by index, because the second reader below is a
# different root whose indices are not this one's.
declare -A mac_to_idx used_idx mac_to_alt

# read_pins DIR PIN  — scan DIR's link files. With PIN=1 the MAC->index pins
# are adopted as well; with PIN=0 only the recorded alternative names are, and
# only where nothing is known yet.
read_pins() {
    local dir="$1" pin="$2" f idx mac alt
    for f in "$dir"/70-lumen-nic*.link; do
        [ -e "$f" ] || continue
        idx="$(basename "$f")"; idx="${idx#70-lumen-nic}"; idx="${idx%.link}"
        case "$idx" in *[!0-9]*|'') continue ;; esac
        mac="$(sed -n 's/^PermanentMACAddress=//p' "$f" | head -n1 | tr 'A-F' 'a-f')"
        [ -n "$mac" ] || continue
        if [ "$pin" = 1 ]; then
            mac_to_idx["$mac"]="$idx"
            used_idx["$idx"]=1
        fi
        alt="$(sed -n 's/^AlternativeName=//p' "$f" | head -n1)"
        if [ -n "$alt" ] && [ -z "${mac_to_alt[$mac]:-}" ]; then mac_to_alt["$mac"]="$alt"; fi
    done
}

read_pins "$LINKDIR" 1
# Writing into an install target, from a live environment that has already
# renamed these adapters: /sys now says nic<N>, so the kernel's original name
# survives only in the live root's own link file. Without this the installed
# system gets no AlternativeName at all and the console's Alternative Name
# column is empty on every fresh install. The live root never pins indices —
# those come from the target, which is the system being built.
if [ "$LINKDIR" != "/etc/systemd/network" ]; then
    read_pins /etc/systemd/network 0
fi

# --- assign indices: keep pins, give new NICs the next free index -----------
next_free() {
    local i=0
    while [ -n "${used_idx[$i]:-}" ]; do i=$((i + 1)); done
    echo "$i"
}
declare -A dev_to_idx
for entry in "${nics[@]}"; do
    read -r _ mac dev <<<"$entry"
    mac="$(tr 'A-F' 'a-f' <<<"$mac")"
    if [ -z "${mac_to_idx[$mac]:-}" ]; then
        idx="$(next_free)"
        mac_to_idx["$mac"]="$idx"
        used_idx["$idx"]=1
    fi
    dev_to_idx["$dev"]="${mac_to_idx[$mac]}"
done

# --- write the link files -----------------------------------------------------
mkdir -p "$LINKDIR"
for entry in "${nics[@]}"; do
    read -r _ mac dev <<<"$entry"
    mac="$(tr 'A-F' 'a-f' <<<"$mac")"
    idx="${dev_to_idx[$dev]}"
    # The kernel's own name, if this NIC is being renamed; otherwise whatever
    # an earlier run recorded for this MAC, so a re-run never loses it.
    if [ "$dev" != "nic$idx" ]; then alt="$dev"; else alt="${mac_to_alt[$mac]:-}"; fi
    {
        cat <<EOF
# Written by lumen-nicnames. MAC pin is authoritative; do not renumber.
[Match]
PermanentMACAddress=$mac

[Link]
Name=nic$idx
EOF
        if [ -n "$alt" ]; then echo "AlternativeName=$alt"; fi
    } > "$LINKDIR/70-lumen-nic$idx.link"
    echo "nic$idx: $mac ($dev)${alt:+ [$alt]}"
done

# --- optionally rename the running interfaces in place ----------------------
# Two passes via temporary names so an existing nic<N> can never collide
# with a rename target. Interfaces are left down; NetworkManager (started
# after this tool in the live environment) brings them up as needed.
if [ "$APPLY" = 1 ]; then
    [ "${ROOT%/}" = "" ] || die "--apply only makes sense with --root /"
    for dev in "${!dev_to_idx[@]}"; do
        [ "$dev" != "nic${dev_to_idx[$dev]}" ] || continue
        ip link set "$dev" down
        ip link set "$dev" name "lumen-tmp${dev_to_idx[$dev]}"
    done
    for dev in "${!dev_to_idx[@]}"; do
        [ "$dev" != "nic${dev_to_idx[$dev]}" ] || continue
        ip link set "lumen-tmp${dev_to_idx[$dev]}" name "nic${dev_to_idx[$dev]}"
    done
fi
